# Domain
DOMAIN=localhost
FRONTEND_HOST=http://localhost
ENVIRONMENT=production

PROJECT_NAME="Finance Agent"
STACK_NAME=finance-agent
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LangSmith Observability (optional)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=your_langsmith_project_name
LANGCHAIN_TRACING_V2=false
LANGSMITH_ENDPOINT=https://aws.api.smith.langchain.com

# Backend Security & Admin
BACKEND_CORS_ORIGINS="https://finance-agent.brnch.in,http://finance-agent.brnch.in"
SECRET_KEY=change_this_to_a_random_secret_key

FIRST_SUPERUSER=asdf
FIRST_SUPERUSER_PASSWORD=asdf

# Clerk Authentication
# Fetch dev keys with `clerk env pull` after `clerk link`. Never commit real keys here.
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# From Clerk Dashboard -> Webhooks -> your endpoint -> Signing Secret (Svix verification).
CLERK_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Reserved ngrok domain for local webhook delivery (scripts/dev.sh). Clerk needs
# a publicly reachable URL to deliver organization/membership events; without it
# invites will not move users between organizations.
# Register in Clerk as: https://$NGROK_DOMAIN/api/v1/webhooks/clerk
NGROK_DOMAIN=your-reserved-domain.ngrok-free.app

# Redis (rate limiting)
# Local: redis://localhost:6379/0
# Prod: point at the native redis6-server via the Docker bridge gateway IP, e.g. redis://172.17.0.1:6379/0
REDIS_URL=redis://localhost:6379/0

# Database Connection
# Postgres is required: the Alembic chain contains Postgres-only DDL, and RAG
# needs the pgvector extension (CREATE EXTENSION vector).
# Local dev example (Homebrew postgresql@18 + pgvector on :5433):
DATABASE_URL=postgresql+psycopg://user:password@localhost:5433/finance_harness
# Production: point at the native Postgres on the EC2 host.

# Used only when DATABASE_URL is unset
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_DB=finance_harness
POSTGRES_USER=your_pg_user
POSTGRES_PASSWORD=your_pg_password

