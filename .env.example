# Domain
DOMAIN=localhost
FRONTEND_HOST=http://localhost
ENVIRONMENT=production

PROJECT_NAME="Finance Agent"
STACK_NAME=finance-agent
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# LangSmith Observability (optional)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=your_langsmith_project_name
LANGCHAIN_TRACING_V2=false
LANGSMITH_ENDPOINT=https://aws.api.smith.langchain.com

# Backend Security & Admin
BACKEND_CORS_ORIGINS="https://finance-agent.brnch.in,http://finance-agent.brnch.in"
SECRET_KEY=change_this_to_a_random_secret_key

FIRST_SUPERUSER=asdf
FIRST_SUPERUSER_PASSWORD=asdf

# Database Connection (Persistent host volume mounted at /app/backend/data/app.db)
DATABASE_URL=sqlite:///data/app.db

